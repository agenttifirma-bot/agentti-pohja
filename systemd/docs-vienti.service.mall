# Mallitiedosto, ei asenna mitaan. Kopioi CT115:ssa: /etc/systemd/system/docs-vienti.service. Ohje: docs/agenttidata.md
[Unit]
Description=Docs-vienti: siivottu kopio agenttien tuloksista Gitean repoon tony/agenttidata
After=network-online.target docs-pull.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agentti-pohja
Environment=PYTHONDONTWRITEBYTECODE=1
# Pakollinen: DOCS_VIENTI_OSOITE=ssh://git@<Gitean IP>[:portti]/tony/agenttidata.git (ei salaisuus; tarkistetaan sallittujen listaa vasten).
EnvironmentFile=/etc/docs-vienti/asetukset.env
# Ensin kuiva-ajo omalla kasin: python3 -m agentti.docs_vienti --kuiva. Kompassi ei ole oletuksena mukana (lisaa --kompassi vain Tonyn luvalla).
ExecStart=/usr/bin/python3 -B -m agentti.docs_vienti
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/docs-vienti
ReadOnlyPaths=/opt/agenttifirma-docs /etc/docs-vienti
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
