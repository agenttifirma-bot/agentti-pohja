# Mallitiedosto, ei asenna mitaan. Kopioi CT115:ssa: /etc/systemd/system/docs-vienti.timer.
# Kerran 15 min valein; docs-pull.service on jarjestyksessa ennen (After=), joten kopio on tuore, jos pull sattuu samalle minuutille.
[Unit]
Description=Docs-vienti 15 min valein

[Timer]
OnCalendar=*:07,22,37,52
Persistent=false
Unit=docs-vienti.service

[Install]
WantedBy=timers.target
