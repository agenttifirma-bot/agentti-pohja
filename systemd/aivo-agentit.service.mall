# Eristettyjen agenttien ajuri (kontti 122). Kopioi: /etc/systemd/system/aivo-agentit.service. Ohje: docs/aivo-agentit.md
# --roolit: sama avoin malli kuin chatissa (lista AVOIMET_MALLIT, aivo/openrouter_zdr.py). Tarkista polut ohjeen kohdasta 4.
[Unit]
Description=Aivo: eristetyt agentit (jono, yksi tehtava kerrallaan)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aivo-agentti
Group=aivo-agentti
SupplementaryGroups=aivo-agentit aivo-kulut
WorkingDirectory=/opt/agentti-pohja
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/agentti-pohja
ExecStart=/usr/bin/python3 -m aivo.agentti_ajuri palvelu --perus /var/lib/aivo-agentit --roolit qwen/qwen3-235b-a22b-2507
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
# Kirjoitus vain omaan kansioon ja kulukirjanpitoon. Kulukirjanpito vaatii kirjoitusoikeuden kansioon; tiedostokohtainen
# rajaus tehdaan oikeuksilla (ryhma aivo-kulut, kansiossa sticky-bitti: muiden tiedostoja ei voi poistaa eika korvata).
ReadWritePaths=/var/lib/aivo-agentit /var/lib/claude-jono
# Toinen lukko tiedosto-oikeuksien lisaksi: muisti, keskustelut, ydinohjeet ja tyokalutila eivat nay.
InaccessiblePaths=-/var/lib/aivo-yksityinen -/var/lib/aivo -/var/lib/aivo-tyokalu
MemoryMax=512M
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
