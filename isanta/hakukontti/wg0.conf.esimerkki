# WireGuard-asetuksen esimerkkipohja hakukonttiin (wg-quick@wg0). EI kayteta sellaisenaan.
# Oikea tiedosto haetaan VPN-palvelun sivulta (Linux, yksi palvelin) ja tuodaan konttiin polkuun /etc/wireguard/wg0.conf
# (root:root 0600). Ohje: docs/aivo-hakukontti.md. Avaimet ovat paikkamerkkeja, ja osoitteet ovat dokumentaatioalueilta
# (RFC 5737), joten wg_asetus.py hylkaa taman pohjan (endpoint_ei_julkinen).
# Vaatimukset (wg_asetus.py tarkista): yksi [Peer]; Endpoint on julkinen IPv4-osoite ja portti (ei nimi, koska
# nimipalvelua ei sallita); AllowedIPs = 0.0.0.0/0; ei IPv6-osoitteita; ei DNS-rivia (Tor ratkaisee nimet itse);
# ei PreUp/PostUp/PreDown/PostDown-komentoja; FwMark puuttuu tai on 51820 (palomuuri tunnistaa WireGuardin merkista).
# wg_asetus.py siivoa poistaa VPN-palvelun tiedostosta DNS-rivin ja IPv6-osoitteet ja lisaa PersistentKeepalive = 25.

[Interface]
PrivateKey = @YKSITYINEN_AVAIN@
Address = 192.0.2.2/32

[Peer]
PublicKey = @PALVELIMEN_JULKINEN_AVAIN@
AllowedIPs = 0.0.0.0/0
Endpoint = 203.0.113.10:51820
PersistentKeepalive = 25
