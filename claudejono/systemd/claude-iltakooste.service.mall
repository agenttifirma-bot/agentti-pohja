# Mallitiedosto: ei asenna mitaan. Koetilan iltaviesti: ilman CLAUDEJONO_KOEPAIVA-koetilaa ei laheta mitaan.
[Unit]
Description=Claude-jono: koetilan iltaviesti Telegramiin (aamukoosteen siirretyt asiat)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agentti-pohja
Environment=CLAUDEJONO_REPO=/var/lib/claude-jono/docs
Environment=YOJONO_PERUS=/var/lib/yojono
EnvironmentFile=-/etc/yojono/telegram.env
# Koepaiva (CLAUDEJONO_KOEPAIVA=2026-11-20) asetetaan samassa tiedostossa kuin muut asetukset
EnvironmentFile=-/etc/claude-jono/asetukset.env
ExecStart=/usr/bin/python3 -B -m claudejono.aamukooste --ilta --laheta
TimeoutStartSec=300
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
