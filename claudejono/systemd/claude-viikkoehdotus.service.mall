# Mallitiedosto: ei asenna mitaan. Asennus README.md:n mukaan (osio Aamukooste).
[Unit]
Description=Claude-jono: viikkosuunnittelun ehdotuspohja (sunnuntai)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agentti-pohja
Environment=CLAUDEJONO_REPO=/var/lib/claude-jono/docs
Environment=CLAUDEJONO_VIIKKO_HAK=/var/lib/claude-jono/viikko
EnvironmentFile=-/etc/yojono/telegram.env
ExecStart=/usr/bin/python3 -B -m claudejono.viikkoehdotus --laheta
TimeoutStartSec=120
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/claude-jono/viikko
ProtectHome=true
NoNewPrivileges=true
